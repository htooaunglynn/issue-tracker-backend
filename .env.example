# Server
PORT=:8080
ENV=development
LOG_LEVEL=info

# Database
# For local development (running `make run` outside Docker):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/issuetracker?sslmode=disable
# For Docker Compose (running `make up`), the api service already sets this in docker-compose.yml:
# DATABASE_URL=postgres://postgres:postgres@postgres:5432/issuetracker?sslmode=disable
DB_MAX_CONNECTIONS=25
DB_MAX_IDLE_TIME=5

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY_HOURS=1
JWT_REFRESH_EXPIRY_DAYS=7

# SMTP (Email)
# Drivers: smtp, log, noop
# For local dev, use "log" to print emails to console
EMAIL_DRIVER=log
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@issuetracker.local

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
